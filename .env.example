# LLM 服务配置
# 大模型 API 地址
# 提示：如果是本地直接运行，默认填 localhost 即可。
# 如果代码运行在 WSL2 或 Docker 中，而 Ollama 运行在宿主机，请将其修改为宿主机的局域网 IP。
OLLAMA_URL=http://localhost:11434/api/generate

# 预留覆盖项
# 如果您想更改默认的模型或路径，取消下方注释并修改即可覆盖 config.py 中的默认值
# LLM_MODEL=llama3:8b
# EMBED_MODEL_PATH=./models/bge-small-zh-v1.5
# RERANK_MODEL_PATH=./models/bge-reranker-base